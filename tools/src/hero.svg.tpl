    <text class="jbb" x="634" y="479" font-size="13" fill="#eceef6" letter-spacing="2">REC</text>
    <text class="jb" x="1246" y="479" font-size="12" fill="#8d93ab" text-anchor="end" letter-spacing="1.5">OMAR_HELLO.MP4 &#183; 24FPS</text>
  </g>
  <!-- scrub bar synced to the video loop -->
  <g class="fi" style="animation-delay:.8s">
    <rect x="600" y="508" width="660" height="3" rx="1.5" fill="#ffffff" fill-opacity=".12"/>
    <rect x="600" y="508" width="0" height="3" rx="1.5" fill="url(#nameG2)">
      <animate attributeName="width" values="0;660" dur="4.0s" repeatCount="indefinite"/>
    </rect>
  </g>

  <!-- LEFT COPY -->
  <g class="fu" style="animation-delay:.2s">
